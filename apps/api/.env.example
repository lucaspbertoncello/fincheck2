# Copy this file to `.env` (same folder) to change a default. Every variable is optional:
# without a `.env` the API runs with the values below. No secret goes here.

# Port the API listens on, always on 127.0.0.1. The web dev server reads it too, so the
# two stay in sync.
# API_PORT=3333

# SQLite database file, relative to `apps/api`. Created and migrated on the first start.
# The `local-token` file is written next to it.
# DATABASE_FILE=data/fincheck.db

# Token the API asks for in the `X-Fincheck-Token` header (at least 16 characters). Leave it out:
# the API then generates one and saves it in `data/local-token`, and the web dev server reads it
# from there. Set it only if you want a fixed value.
# LOCAL_TOKEN=
